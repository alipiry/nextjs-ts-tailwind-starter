{
  "name": "nextjs-ts-tailwind-starter",
  "version": "0.0.1",
  "description": "A Next.js starter template with TypeScript and Tailwind CSS",
  "author": "Ali Piry",
  "license": "MIT",
  "keywords": [
    "nextjs",
    "typescript",
    "tailwindcss",
    "starter"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/alipiry/nextjs-ts-tailwind-starter.git"
  },
  "bugs": {
    "url": "https://github.com/alipiry/nextjs-ts-tailwind-starter/issues"
  },
  "homepage": "https://github.com/alipiry/nextjs-ts-tailwind-starter#readme",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "lint:strict": "eslint --max-warnings=0 src",
    "format": "prettier -w .",
    "format:check": "prettier -c .",
    "typecheck": "tsc --noEmit --incremental false",
    "prepare": "husky"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.1.16",
    "framer-motion": "^12.23.24",
    "next": "^16.0.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sharp": "^0.34.4"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "clsx": "^2.1.1",
    "eslint": "^9.39.1",
    "eslint-config-next": "^16.0.1",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.6",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.7.1",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.1.16",
    "typescript": "^5.9.3"
  }
}
