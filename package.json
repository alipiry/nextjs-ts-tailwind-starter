{
  "name": "nextjs-ts-tailwind-starter",
  "version": "0.0.1",
  "description": "A Next.js starter template with TypeScript and Tailwind CSS",
  "author": "Ali Piry",
  "license": "MIT",
  "keywords": [
    "nextjs",
    "typescript",
    "tailwindcss",
    "starter"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/alipiry/nextjs-ts-tailwind-starter.git"
  },
  "bugs": {
    "url": "https://github.com/alipiry/nextjs-ts-tailwind-starter/issues"
  },
  "homepage": "https://github.com/alipiry/nextjs-ts-tailwind-starter#readme",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src",
    "lint:strict": "eslint --max-warnings=0 src",
    "format": "prettier -w .",
    "format:check": "prettier -c .",
    "typecheck": "tsc --noEmit --incremental false",
    "commitlint": "commitlint --edit",
    "prepare": "husky"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=11.0.0"
  },
  "packageManager": "pnpm@11.10.0",
  "dependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "framer-motion": "^13.2.0",
    "next": "^16.3.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.0",
    "@commitlint/config-conventional": "^21.2.0",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^25.9.5",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "clsx": "^2.1.1",
    "eslint": "^9.39.2",
    "eslint-config-next": "^16.2.10",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "postcss": "^8.5.16",
    "prettier": "^3.9.4",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.2",
    "typescript": "^5.9.3"
  }
}
